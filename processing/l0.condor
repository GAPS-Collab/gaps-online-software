#################################################################
# CONDOR SUMBISSION FILE - GAPS data assembly and production
#   -- SPRING 2026
#   -- Assembly of flight data and advanced processing for GAPS I
#   

#L0_DIR=/data/stoessl/flight/GAPSI/dataset/L0/starlink 
L0_DIR=/data/stoessl/flight/GAPSI/dataset/L0/gcu_2_gcupool
EXE=/home/stoessl/gaps-online-software-v0.12/processing/l0.sh

runid = $Fdb(dirname)

executable     = $(EXE) 
arguments      = $(runid)

# merge output and error log
output         = /data/stoessl/logs/l0/gcupool/l0-$(runid)-$(Process).log
error          = /data/stoessl/logs/l0/gcupool/l0-$(runid)-$(Process).log
log            = /data/stoessl/logs/l0/gcupool/all-jobs.log
make_log_dir   = True


# requirements & environment
request_memory = 4000
getenv         = True
environment = "VIRTUAL_ENV="

initialdir = /home/stoessl/gondola-test
queue dirname matching dirs $(L0_DIR)/*/
